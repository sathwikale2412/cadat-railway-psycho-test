# CADAT Simulator — cloud sync (optional)
#
# Without these the app runs device-only and stays fully usable.
# Find both values in Supabase > Project Settings > API.
# Use the SAME project as Day to Day Activity so one account signs you in to both apps.
# In Vercel, add them as Environment Variables with the "Env Production" + "Env Preview"
# scopes and type "Config" (VITE_ vars are inlined into the client bundle).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
